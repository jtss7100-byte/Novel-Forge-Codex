{
  "type": "object",
  "description": "서버가 작성한 통합 결과; AI가 직접 생성하는 스키마가 아니다.",
  "properties": {
    "manuscript_state": {
      "type": "string",
      "enum": [
        "BLOCKED_CONFLICT",
        "BLOCKED_MISSING_INFO",
        "DRAFT_READY",
        "REVIEW_REQUIRED",
        "APPROVED"
      ]
    },
    "canon_status": {
      "type": "string",
      "enum": [
        "CANON_CANDIDATE",
        "NON_CANON_EXCEPTION",
        "CANON"
      ]
    },
    "audit_execution_state": {
      "type": "object",
      "properties": {
        "continuity_checker": {
          "type": "string",
          "enum": [
            "NOT_RUN",
            "PASSED",
            "ISSUES_FOUND",
            "AUDIT_FAILED"
          ]
        },
        "style_editor": {
          "type": "string",
          "enum": [
            "NOT_RUN",
            "PASSED",
            "ISSUES_FOUND",
            "AUDIT_FAILED"
          ]
        }
      },
      "required": [
        "continuity_checker",
        "style_editor"
      ],
      "additionalProperties": false
    },
    "manuscript": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "WRITER",
              "CONTINUITY_CHECKER",
              "STYLE_EDITOR"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "INFO",
              "WARNING",
              "CRITICAL_BLOCK"
            ]
          },
          "manuscript_location": {
            "type": [
              "string",
              "null"
            ],
            "description": "문제와 연결된 실제 원고 위치. 집필 전 보류이거나 위치를 확인할 수 없으면 null"
          },
          "reference_lore_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "실제 제공된 확정 설정·연표의 출처 ID만 허용; 미존재·무관할 경우 null"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "issue_id",
          "source",
          "severity",
          "manuscript_location",
          "reference_lore_id",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proposal_id": {
            "type": "string"
          },
          "resolution_type": {
            "type": "string",
            "enum": [
              "ONE_TIME_EXCEPTION",
              "PERMANENT_LORE_UPDATE",
              "CANON_PROMOTION",
              "TEXT_REVISION"
            ]
          },
          "target_location_or_lore_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "실재하는 원고 위치 또는 출처 ID. 대상 없음/미확인 시 null"
          },
          "proposed_change": {
            "type": "string"
          },
          "impact_analysis": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "proposal_id",
          "resolution_type",
          "target_location_or_lore_id",
          "proposed_change",
          "impact_analysis"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "manuscript_state",
    "canon_status",
    "audit_execution_state",
    "manuscript",
    "issues",
    "proposals"
  ],
  "additionalProperties": false
}
