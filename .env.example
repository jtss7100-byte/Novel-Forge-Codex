# ==============================================================================
# NOVEL FORGE — Environment Variables Configuration (.env.example)
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI generation and live embeddings.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_WRITING_MODEL: Model ID used for Novel Writer, Plot Planner, and Style Editor.
# Defaults to gemini-3.8-flash.
GEMINI_WRITING_MODEL="gemini-3.8-flash"

# GEMINI_EMBEDDING_MODEL: Active embedding model ID for RAG vector search.
# Uses gemini-embedding-2 (768 dimensions, without legacy taskType).
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# GEMINI_EMBEDDING_DIMENSION: Embedding vector dimension (Firestore supports 1~2048).
# Defaults to 768. Exceeding 2048 triggers FIRESTORE_VECTOR_DIMENSION_OUT_OF_RANGE(400).
GEMINI_EMBEDDING_DIMENSION="768"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# NOVELFORGE_ENFORCE_CLOUD_AUTH: Set to "true" in production to enforce strict
# Firebase ID token verification and direct Firestore project ownership checks.
NOVELFORGE_ENFORCE_CLOUD_AUTH="false"

# FIREBASE_PROJECT_ID: Cloud Firebase project identifier.
FIREBASE_PROJECT_ID="atomic-future-93kqt"

# FIRESTORE_DATABASE_ID: Named Firestore database ID used by NOVEL FORGE.
FIRESTORE_DATABASE_ID="ai-studio-d14675c1-78ff-41b1-8c46-397a79df1749"

# ==============================================================================
# Live Cloud Integration Test Switches (Isolated from Production)
# ==============================================================================

# RUN_LIVE_CLOUD_TESTS: Explicitly set to "true" ONLY when running live cloud tests
# against an isolated test Firebase project and Firestore database.
RUN_LIVE_CLOUD_TESTS="false"

# Isolated test project/database identifiers (MUST differ from production DB)
TEST_FIREBASE_PROJECT_ID=""
TEST_FIRESTORE_DATABASE_ID=""

# Isolated test service account credentials (path or raw JSON string)
TEST_GOOGLE_APPLICATION_CREDENTIALS=""
TEST_FIREBASE_SERVICE_ACCOUNT_KEY=""

